    {
      "id": "Q01",
      "type": "single_choice",
      "prompt": "地球と太陽の運動について、正しい文を1つ選びなさい。",
      "options": [
        {
          "id": "a",
          "label": "地球は太陽のまわりを回っている。"
        },
        {
          "id": "b",
          "label": "太陽は地球のまわりを回っている。"
        },
        {
          "id": "c",
          "label": "地球は月のまわりを回っている。"
        },
        {
          "id": "d",
          "label": "太陽と地球は互いのまわりを同じ半径で回っている。"
        }
      ],
      "answerKey": {
        "optionId": "a"
      },
      "explanation": "地球は太陽のまわりを公転しています。",
      "tags": [
        "理科",
        "単一選択"
      ]
    },
    {
      "id": "Q02",
      "type": "multiple_choice",
      "prompt": "次のうち、再生可能エネルギーをすべて選びなさい。",
      "options": [
        {
          "id": "solar",
          "label": "太陽光発電"
        },
        {
          "id": "wind",
          "label": "風力発電"
        },
        {
          "id": "oil",
          "label": "石油"
        },
        {
          "id": "hydro",
          "label": "水力発電"
        },
        {
          "id": "gas",
          "label": "天然ガス"
        }
      ],
      "minSelections": 1,
      "maxSelections": 5,
      "answerKey": {
        "optionIds": [
          "solar",
          "wind",
          "hydro"
        ]
      },
      "explanation": "太陽光・風力・水力は再生可能エネルギーです。",
      "tags": [
        "理科",
        "複数選択"
      ]
